# ---------------------------------------------------------------------------
# Copy to `.env.local` for development, and set the same keys in the Vercel
# dashboard for production. Never commit `.env.local`.
#
# Everything here except NEXT_PUBLIC_SITE_URL is server-only and must never be
# prefixed with NEXT_PUBLIC_ — that prefix inlines a value into the client bundle.
# ---------------------------------------------------------------------------

# --- Admin identity (single user, no database) ------------------------------
ADMIN_USERNAME=admin
# bcrypt hash — generate with `npm run hash-password`. Never store plaintext.
ADMIN_PASSWORD_HASH=

# --- Auth.js ----------------------------------------------------------------
# Signing key for the JWT session. Generate with `npx auth secret`
# or `openssl rand -base64 32`.
AUTH_SECRET=

# --- GitHub content repository (production writes) --------------------------
# Fine-grained PAT scoped to THIS repository only, with `Contents: Read and write`.
# Nothing broader is needed.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# --- Site -------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, OG tags,
# sitemap, RSS and llms.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------
# Force a content backend instead of the NODE_ENV-based default.
#   local  -> read/write content/posts on disk (dev default)
#   github -> read/write through the GitHub API (production default)
# Set to `github` locally to exercise the production write path end to end.
# CONTENT_SOURCE=
